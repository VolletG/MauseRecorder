                                                    <TextBlock Text="Record a take or summon the demo." Style="{StaticResource Caption}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                                                    <Button Content="Watch demo" Style="{StaticResource AccentQuietButton}" Click="Demo_Click"
                                                            HorizontalAlignment="Center" Margin="0,12,0,0" />
                                                </StackPanel>
                                            </Grid>

                                            <Grid Grid.Row="2" Margin="0,8,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="COLD" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <Border Width="82" Height="6" CornerRadius="3">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                <GradientStop Color="#2A1D4F" Offset="0" />
                                                                <GradientStop Color="#8B5CF6" Offset="0.45" />
                                                                <GradientStop Color="#FF9142" Offset="0.75" />
                                                                <GradientStop Color="#FF5668" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <TextBlock Text="HOT" Style="{StaticResource Micro}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                                </StackPanel>
                                                <TextBlock Text="Click density · all takes" Style="{StaticResource Caption}" FontSize="10"
                                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                        <Border Style="{StaticResource Card}" Padding="18,15">
                                            <StackPanel>
                                                <TextBlock Text="TOTAL CLICKS" Style="{StaticResource Micro}" />
                                                <TextBlock x:Name="HeatTotal" Text="0" Style="{StaticResource Metric}" FontSize="38" Margin="0,2,0,0" />
                                                <TextBlock x:Name="HeatTakesLabel" Text="No data yet" Style="{StaticResource Caption}" FontSize="10.5" />

                                                <Border Style="{StaticResource Divider}" Margin="0,12" />

                                                <Grid Margin="0,0,0,8">
                                                    <TextBlock Text="Hot zone" Style="{StaticResource Caption}" FontSize="11" />
                                                    <TextBlock x:Name="HeatHotspot" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                                </Grid>
                                                <Grid Margin="0,0,0,11">
                                                    <TextBlock Text="Favourite button" Style="{StaticResource Caption}" FontSize="11" />
                                                    <TextBlock x:Name="HeatButton" Text="—" FontSize="11.5" FontWeight="SemiBold"
                                                               HorizontalAlignment="Right" Foreground="{DynamicResource TextBrush}" />
                                                </Grid>

                                                <Grid Height="7">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition x:Name="HeatLeftColumn" Width="1*" />
                                                        <ColumnDefinition Width="3" />
                                                        <ColumnDefinition x:Name="HeatRightColumn" Width="1*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Background="#FF5668" CornerRadius="4" />
                                                    <Border Grid.Column="2" Background="{DynamicResource AccentBrush}" CornerRadius="4" />
                                                </Grid>
                                                <Grid Margin="0,5,0,0">
                                                    <TextBlock x:Name="HeatLeftLabel" Text="L 0%" Style="{StaticResource Caption}" FontSize="9" />
                                                    <TextBlock x:Name="HeatRightLabel" Text="R 0%" Style="{StaticResource Caption}" FontSize="9"
                                                               HorizontalAlignment="Right" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>

                                        <Border Style="{StaticResource Card}" Padding="18,15" Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="CURSOR ROAST" Style="{StaticResource Eyebrow}" />
                                                <TextBlock x:Name="RoastText" Text="Record a little chaos and I'll judge your cursor."
                                                           Style="{StaticResource Body}" FontSize="12" FontStyle="Italic" Margin="0,7,0,0" />
                                                <Button Content="Another one ↻" Style="{StaticResource QuietButton}" HorizontalAlignment="Left"
                                                        Padding="0,8,0,0" Click="Roast_Click" FontSize="11" />
                                            </StackPanel>
                                        </Border>

                                        <TextBlock Text="mauserecorder · made of clicks" Style="{StaticResource Caption}" FontSize="8.5"
                                                   HorizontalAlignment="Center" Margin="0,11,0,0" Foreground="#414858" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ═════════════ SETTINGS PAGE ═════════════ -->
                    <ScrollViewer x:Name="SettingsPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,0">
