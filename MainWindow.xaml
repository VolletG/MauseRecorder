                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Copy stats" Style="{StaticResource GhostButton}" Click="CopyStats_Click" Padding="14,9" FontSize="12" />
