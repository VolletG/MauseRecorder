                                                    <TextBlock Text="Minimize while recording" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="Get the app out of the way and into the vibe." Style="{StaticResource SettingNote}" />
                                                </StackPanel>
                                                <CheckBox x:Name="MinimizeRecordToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                          Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </Grid>

                                            <Border Style="{StaticResource Divider}" Margin="0,12" />
                                            <Grid>
                                                <StackPanel Margin="0,0,72,0">
                                                    <TextBlock Text="Minimize while replaying" Style="{StaticResource SettingTitle}" />
