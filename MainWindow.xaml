                                            <Grid>
                                                <StackPanel Margin="0,0,72,0">
                                                    <TextBlock Text="Click sounds" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="A satisfying tick for every click." Style="{StaticResource SettingNote}" />
                                                </StackPanel>
                                                <CheckBox x:Name="ClickSoundToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                          Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </Grid>

                                            <Border Style="{StaticResource Divider}" Margin="0,12" />
                                            <Grid>
                                                <StackPanel Margin="0,0,72,0">
                                                    <TextBlock Text="Party mode" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="Confetti when a replay ends. Mandatory fun." Style="{StaticResource SettingNote}" />
                                                </StackPanel>
                                                <CheckBox x:Name="PartyToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                          Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </Grid>

                                            <Border Style="{StaticResource Divider}" Margin="0,12" />
                                            <Grid>
                                                <StackPanel Margin="0,0,72,0">
                                                    <TextBlock Text="Gremlin mode" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="Adds ±5 px of chaos to every click. Unhinged." Style="{StaticResource SettingNote}" />
                                                </StackPanel>
                                                <CheckBox x:Name="GremlinToggle" Style="{StaticResource Switch}" VerticalAlignment="Center"
                                                          Checked="SettingToggle_Changed" Unchecked="SettingToggle_Changed" />
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="CAPTURE" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="What gets written into a take." Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0" />

                                            <Border Style="{StaticResource Divider}" />

                                            <Grid>
                                                <StackPanel Margin="0,0,124,0">
                                                    <TextBlock Text="Countdown" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="Time to switch windows before the magic starts." Style="{StaticResource SettingNote}" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <RadioButton x:Name="CountdownOff" Content="Off" Style="{StaticResource ChipRadio}"
                                                                 GroupName="Countdown" Tag="0" Checked="Countdown_Checked" Margin="0,0,5,0" />
                                                    <RadioButton x:Name="Countdown3" Content="3s" Style="{StaticResource ChipRadio}"
                                                                 GroupName="Countdown" Tag="3" Checked="Countdown_Checked" Margin="0,0,5,0" />
                                                    <RadioButton x:Name="Countdown5" Content="5s" Style="{StaticResource ChipRadio}"
                                                                 GroupName="Countdown" Tag="5" Checked="Countdown_Checked" />
                                                </StackPanel>
                                            </Grid>

                                            <Border Style="{StaticResource Divider}" Margin="0,12" />
                                            <Grid>
                                                <StackPanel Margin="0,0,72,0">
                                                    <TextBlock Text="Capture mouse motion" Style="{StaticResource SettingTitle}" />
                                                    <TextBlock Text="Turn off for clicks-only, teleport-style takes." Style="{StaticResource SettingNote}" />
