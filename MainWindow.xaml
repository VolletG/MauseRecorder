<Window x:Class="MauseRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MauseRecorder.Controls"
        xmlns:models="clr-namespace:MauseRecorder.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="MauseRecorder"
        Icon="Assets/app.ico"
        Width="1240" Height="820"
        MinWidth="1040" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource BgBrush}"
        SnapsToDevicePixels="True"
        UseLayoutRounding="True"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                            CornerRadius="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource H3}">
            <Setter Property="FontSize" Value="13.5" />
        </Style>
        <Style x:Key="SettingNote" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="#151922" />
            <Setter Property="BorderBrush" Value="#2B3140" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,3" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Divider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Margin" Value="0,14" />
        </Style>
    </Window.Resources>

    <Border x:Name="WindowFrame" Background="{DynamicResource BgBrush}" BorderBrush="#181B23" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- ══════════════════════════ Title bar ══════════════════════════ -->
            <Grid Grid.Row="0" Background="#090A0E" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource AccentBrush}">
                        <Path Data="M5,2 L5,20 L9.6,15.4 L13,23 L16,21.6 L12.7,14.4 L20,14.4 Z"
                              Fill="#08080B" Stretch="Uniform" Width="14" Height="15"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="MauseRecorder" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" Margin="9,0,0,0" />
                    <Border Background="#11141B" BorderBrush="#242A36" BorderThickness="1" CornerRadius="5"
                            Padding="5,2" Margin="8,1,0,0" VerticalAlignment="Center">
                        <TextBlock Text="v1.0" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource FaintBrush}" />
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Border Background="#0F1218" BorderBrush="#222733" BorderThickness="1" CornerRadius="99" Padding="10,5">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#697185" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" Text="READY" FontSize="9.5" FontWeight="Bold"
                                       Foreground="{DynamicResource MutedBrush}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="StatusDetail" Text="Waiting for a take" Style="{StaticResource Caption}"
                               FontSize="10.5" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                    <TextBlock Text="Ctrl + Alt + R" Style="{StaticResource Caption}" FontSize="10.5"
                               VerticalAlignment="Center" Margin="0,0,12,0" Foreground="#555D6E" />
                    <Button Content="&#xE921;" Style="{StaticResource WindowButton}" Click="Minimize_Click" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource WindowButton}" Click="Maximize_Click" ToolTip="Maximize" />
                    <Button Content="&#xE8BB;" Style="{StaticResource CloseWindowButton}" Click="Close_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- ══════════════════════════ Body ══════════════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="#090A0E" BorderBrush="#161920" BorderThickness="0,0,1,0">
                    <Grid Margin="14,18,14,16">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                            <TextBlock Text="WORKSPACE" Style="{StaticResource Micro}" Margin="12,0,0,9" />

                            <RadioButton x:Name="NavRecorder" Style="{StaticResource NavButton}" GroupName="Nav"
                                         IsChecked="True" Tag="recorder" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,11,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M5 3 L5 20 L10 15 L13.5 22 L16.4 20.6 L13 14 L20 14 Z"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeLineJoin="Round" />
                                            <Path Data="M12 2 L13 5 M7 2.5 L8.2 5.4 M2.5 7 L5.4 8.2"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Recorder" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavArchive" Style="{StaticResource NavButton}" GroupName="Nav"
                                         Tag="archive" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,11,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M16 6 L20 20 M12 6 L12 20 M8 7 L8 20 M4 4 L4 20"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Archive" VerticalAlignment="Center" />
                                    <Border x:Name="ArchiveNavBadge" Background="#171B24" CornerRadius="99" Padding="7,2"
                                            Margin="8,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="ArchiveNavCount" Text="0" FontSize="9.5" FontWeight="Bold"
                                                   Foreground="{DynamicResource MutedBrush}" />
                                    </Border>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavHeatmap" Style="{StaticResource NavButton}" GroupName="Nav"
                                         Tag="heatmap" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,11,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M2 12 H5.2 A2 2 0 0 1 7.2 10.6 L9.5 2.5 L14.3 21.5 L16.7 13.4 A2 2 0 0 1 18.7 12 H22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Heatmap" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav"
                                         Tag="settings" Checked="Nav_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17" Margin="0,0,11,0">
                                        <Canvas Width="24" Height="24">
                                            <Path Data="M21 4 H14 M10 4 H3 M21 12 H12 M8 12 H3 M21 20 H16 M12 20 H3"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" />
                                            <Path Data="M14 2 V6 M8 10 V14 M16 18 V22"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                                  StrokeThickness="1.7" StrokeStartLineCap="Round" />
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Settings" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <Border Style="{StaticResource Divider}" Margin="12,16,12,14" />

                            <Border Background="{DynamicResource AccentFaintBrush}" BorderBrush="{DynamicResource AccentSoftBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="13,12">
                                <StackPanel>
                                    <TextBlock Text="QUICK START" Style="{StaticResource Micro}" Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Hit record. Then click like nobody is watching." Style="{StaticResource Caption}"
                                               FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" LineHeight="16" />
                                    <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                        <Border Style="{StaticResource KeyCap}">
                                            <TextBlock Text="Ctrl" FontSize="9" Foreground="#A5ACBC" />
                                        </Border>
                                        <Border Style="{StaticResource KeyCap}">
                                            <TextBlock Text="Alt" FontSize="9" Foreground="#A5ACBC" />
                                        </Border>
                                        <Border Style="{StaticResource KeyCap}">
                                            <TextBlock Text="R" FontSize="9" Foreground="#A5ACBC" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="2">
                            <Button Style="{StaticResource QuietButton}" HorizontalAlignment="Stretch" Padding="10,8"
                                    Click="StarGithub_Click">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <TextBlock Text="★" Foreground="{DynamicResource AccentBrush}" FontSize="12" Margin="0,0,7,0" />
                                    <TextBlock Text="Star on GitHub" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                </StackPanel>
                            </Button>
                            <TextBlock Text="v1.0.0 · Windows 10/11" Style="{StaticResource Caption}" FontSize="9.5"
                                       HorizontalAlignment="Center" Margin="0,8,0,0" Foreground="#414858" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Pages -->
                <Grid x:Name="MainContent" Grid.Column="1" Margin="26,22,26,20" Opacity="0">
                    <Grid.RenderTransform>
                        <TranslateTransform Y="8" />
                    </Grid.RenderTransform>

                    <!-- ═════════════ RECORDER PAGE ═════════════ -->
                    <ScrollViewer x:Name="RecorderPage" Style="{StaticResource PageScroll}">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Recorder" Style="{StaticResource H1}" FontSize="30" LineHeight="33" />
                                    <TextBlock Text="Point. Click. Let it repeat." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource GhostButton}" Click="Demo_Click" Padding="14,9">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="✦" Foreground="{DynamicResource AccentBrush}" Margin="0,0,7,0" FontSize="11" />
                                            <TextBlock Text="Watch demo" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource AccentQuietButton}" Click="OpenFolder_Click" Margin="8,0,0,0">
                                        <TextBlock Text="Open folder" FontSize="12" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Hero -->
                            <Border Height="252" Margin="0,18,0,0" CornerRadius="20" BorderThickness="1"
                                    BorderBrush="{DynamicResource AccentSoftBrush}" ClipToBounds="True">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#15111F" Offset="0" />
                                        <GradientStop Color="#0D0F15" Offset="0.55" />
                                        <GradientStop Color="#0A0B0F" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Grid>
                                    <Ellipse Width="460" Height="460" Fill="{DynamicResource AccentGlowBrush}" Opacity="0.13"
                                             HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,-100,0"
                                             IsHitTestVisible="False">
                                        <Ellipse.Effect>
                                            <BlurEffect Radius="60" />
                                        </Ellipse.Effect>
                                    </Ellipse>

                                    <Grid Margin="28,0,24,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="300" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel VerticalAlignment="Center">
                                            <Border Background="#1AFFFFFF" BorderBrush="{DynamicResource AccentSoftBrush}"
                                                    BorderThickness="1" CornerRadius="99" Padding="9,4" HorizontalAlignment="Left">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                                    <TextBlock Text="MOUSE AUTOMATION STUDIO" Style="{StaticResource Micro}"
                                                               Foreground="{DynamicResource AccentBrush}" FontSize="9" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <TextBlock Style="{StaticResource H1}" FontSize="38" LineHeight="41" Margin="0,12,0,0">
                                                <Run Text="Record. Rewind." /><LineBreak />
                                                <Run Text="Repeat." Foreground="{DynamicResource AccentBrush}" />
                                            </TextBlock>

                                            <TextBlock Style="{StaticResource Body}" MaxWidth="470" Margin="0,9,0,0" FontSize="12.5"
                                                       HorizontalAlignment="Left"
                                                       Text="Every click, drag and scroll — captured and played back frame-perfect. Your mouse just became reusable." />

                                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                                                <Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}"
                                                        Background="#FF4D5E" Foreground="White" Click="Record_Click" Padding="17,11">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="15" Height="15" Margin="0,0,8,0">
                                                            <Ellipse Stroke="White" StrokeThickness="1.5" />
                                                            <Ellipse Width="5" Height="5" Fill="White" />
                                                        </Grid>
                                                        <TextBlock x:Name="RecordButtonText" Text="Start recording" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>
                                                <Button x:Name="HeroPlayButton" Style="{StaticResource GhostButton}"
                                                        Click="PlayLast_Click" Padding="16,11" Margin="10,0,0,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="HeroPlayIcon" Text="▶" FontSize="9" Foreground="{DynamicResource AccentBrush}"
                                                                   VerticalAlignment="Center" Margin="0,1,8,0" />
                                                        <TextBlock x:Name="HeroPlayText" Text="Play last take" FontSize="12.5" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>

                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <TextBlock Text="Tip" Style="{StaticResource Micro}" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,7,0" />
                                                <TextBlock Text="The app gets out of the way automatically. Stop anytime with" Style="{StaticResource Caption}"
                                                           FontSize="10.5" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource KeyCap}" Margin="6,0,0,0">
                                                    <TextBlock Text="Ctrl + Alt + R" FontSize="9" Foreground="#A5ACBC" />
                                                </Border>
                                            </StackPanel>
                                        </StackPanel>

                                        <!-- Orbital cursor -->
                                        <Grid Grid.Column="1" Width="260" Height="220" HorizontalAlignment="Center" IsHitTestVisible="False">
                                            <Ellipse Width="212" Height="212" Stroke="{DynamicResource AccentGlowBrush}" StrokeThickness="1" />
                                            <Ellipse Width="150" Height="150" Stroke="{DynamicResource AccentSoftBrush}" StrokeThickness="1" />
                                            <Ellipse Width="236" Height="236" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                     StrokeDashArray="1 9" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5" Opacity="0.7">
                                                <Ellipse.RenderTransform>
                                                    <RotateTransform />
                                                </Ellipse.RenderTransform>
                                                <Ellipse.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                                                 From="0" To="360" Duration="0:0:26" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Ellipse.Triggers>
                                            </Ellipse>

                                            <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Left"
                                                     VerticalAlignment="Top" Margin="25,44,0,0" Opacity="0.8" />
                                            <Ellipse Width="6" Height="6" Fill="#FF5668" HorizontalAlignment="Right"
                                                     VerticalAlignment="Bottom" Margin="0,0,44,34" Opacity="0.9" />
                                            <Ellipse Width="5" Height="5" Fill="#5EE6A8" HorizontalAlignment="Right"
                                                     VerticalAlignment="Top" Margin="0,54,34,0" Opacity="0.8" />

                                            <Border Width="84" Height="84" CornerRadius="42" Background="#171125"
                                                    BorderBrush="{DynamicResource AccentGlowBrush}" BorderThickness="1.5"
                                                    RenderTransformOrigin="0.5,0.5">
                                                <Border.Effect>
                                                    <DropShadowEffect Color="{DynamicResource AccentColor}" BlurRadius="38" ShadowDepth="0" Opacity="0.55" />
                                                </Border.Effect>
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                                <Border.Triggers>
                                                    <EventTrigger RoutedEvent="Loaded">
                                                        <BeginStoryboard>
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                                                                 From="1" To="1.045" Duration="0:0:2.4">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                                                                 From="1" To="1.045" Duration="0:0:2.4">
                                                                    <DoubleAnimation.EasingFunction>
                                                                        <SineEase EasingMode="EaseInOut" />
                                                                    </DoubleAnimation.EasingFunction>
                                                                </DoubleAnimation>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </EventTrigger>
                                                </Border.Triggers>
                                                <Path Data="M5,2 L5,20 L9.6,15.4 L13,23 L16,21.6 L12.7,14.4 L20,14.4 Z"
                                                      Fill="#F7F7FA" Stretch="Uniform" Width="28" Height="30" />
                                            </Border>

                                            <Border Width="14" Height="14" CornerRadius="7" BorderBrush="#FF5668" BorderThickness="1.5"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,56,80" Opacity="0.85" />
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>

                            <!-- Stats -->
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" CornerRadius="14" Padding="16,13">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="EVENTS" Style="{StaticResource Micro}" />
                                            <TextBlock x:Name="StatEvents" Text="0" Style="{StaticResource Metric}" FontSize="27" Margin="0,3,0,0" />
                                            <TextBlock Text="captured moments" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentFaintBrush}"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M2 12 H5.5 L8.5 3 L13.5 21 L16.5 12 H22" Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1" Style="{StaticResource Card}" CornerRadius="14" Padding="16,13" Margin="12,0">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="DURATION" Style="{StaticResource Micro}" />
                                            <TextBlock x:Name="StatDuration" Text="00:00" Style="{StaticResource Metric}" FontSize="27" Margin="0,3,0,0" />
                                            <TextBlock Text="of pure cursor energy" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="#12303A"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Ellipse Canvas.Left="3" Canvas.Top="3" Width="18" Height="18" Stroke="#22D3EE" StrokeThickness="2" />
                                                    <Path Data="M12 7 V12 L16 14" Stroke="#22D3EE" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}" CornerRadius="14" Padding="16,13">
                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="CLICKS" Style="{StaticResource Micro}" />
                                            <TextBlock x:Name="StatClicks" Text="0" Style="{StaticResource Metric}" FontSize="27" Margin="0,3,0,0" />
                                            <TextBlock Text="tiny acts of intention" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </StackPanel>
                                        <Border Width="32" Height="32" CornerRadius="10" Background="#2A1016"
                                                HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <Viewbox Width="15" Height="15">
                                                <Canvas Width="24" Height="24">
                                                    <Path Data="M5 3 L5 20 L10 15 L13.5 22 L16.4 20.6 L13 14 L20 14 Z" Stroke="#FF5668"
                                                          StrokeThickness="2" StrokeLineJoin="Round" />
                                                </Canvas>
                                            </Viewbox>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Timeline -->
                            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="18,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>
                                        <StackPanel>
                                            <TextBlock Text="Motion timeline" Style="{StaticResource H3}" />
                                            <TextBlock x:Name="TimelineTakeName" Text="Nothing recorded yet" Style="{StaticResource Caption}"
                                                       FontSize="10.5" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <Border Background="#12151C" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="9,5" Margin="0,0,8,0">
                                                <TextBlock x:Name="TimelineEventCount" Text="0 events" Style="{StaticResource Caption}" FontSize="10" />
                                            </Border>
                                            <Button x:Name="TimelinePlayButton" Style="{StaticResource AccentQuietButton}"
                                                    Click="PlayLast_Click" Padding="11,6">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock x:Name="TimelinePlayIcon" Text="▶" FontSize="8" VerticalAlignment="Center" Margin="0,1,6,0" />
                                                    <TextBlock x:Name="TimelinePlayText" Text="Play take" FontSize="11.5" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <controls:TimelineControl x:Name="Timeline" Grid.Row="1" Height="78" Margin="0,5,0,0" />

