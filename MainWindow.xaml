                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" />
                                        <TextBlock x:Name="ArchiveSummary" Text="0 takes · 0 clicks" Style="{StaticResource Caption}" FontSize="11" />
                                    </StackPanel>
                                </Border>
                                <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="9" Padding="12,7" Margin="8,0,0,0">
                                    <TextBlock x:Name="ArchiveTotalTime" Text="00:00 recorded" Style="{StaticResource Caption}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
                            <ListBox x:Name="RecordingsList" Style="{StaticResource CleanListBox}"
                                     ItemContainerStyle="{StaticResource RecordingRow}"
                                     MouseDoubleClick="RecordingsList_MouseDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:Recording}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="46" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border Width="42" Height="42" CornerRadius="12"
                                                    Background="{DynamicResource AccentFaintBrush}"
                                                    BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding CreatedLabel}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="10.5" Foreground="#414858" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                </StackPanel>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border Background="#12151C" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                        CornerRadius="7" Padding="9,5" Margin="0,0,7,0">
                                                    <TextBlock Text="{Binding DurationShort}" Style="{StaticResource Caption}"
                                                               FontSize="10" Foreground="#B2B8C6" />
                                                </Border>
                                                <Button Style="{StaticResource IconButton}" Content="&#xE768;"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Play take"
                                                        Tag="{Binding}" Click="PlayRecording_Click" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE70F;"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Rename"
                                                        Tag="{Binding}" Click="RenameRecording_Click" />
                                                <Button Style="{StaticResource IconButton}" Content="&#xE74D;"
                                                        FontFamily="Segoe MDL2 Assets" FontSize="12" ToolTip="Delete"
                                                        Tag="{Binding}" Click="DeleteRecording_Click" Foreground="#B76570" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border x:Name="ArchiveEmpty" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1" CornerRadius="16" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="380">
                                    <Border Width="70" Height="70" CornerRadius="35" Background="{DynamicResource AccentFaintBrush}"
                                            BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1" HorizontalAlignment="Center">
                                        <Path Data="M5,3 L5,20 L10,15 L13.5,22 L16.4,20.6 L13,14 L20,14 Z" Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform" Width="26" Height="28" />
                                    </Border>
                                    <TextBlock x:Name="ArchiveEmptyTitle" Text="Your archive is a blank canvas" Style="{StaticResource H2}"
                                               FontSize="21" HorizontalAlignment="Center" Margin="0,17,0,0" />
                                    <TextBlock x:Name="ArchiveEmptyText" Text="Record a take and it will land here automatically. No cloud, no account, no nonsense."
                                               Style="{StaticResource Body}" TextAlignment="Center" Margin="0,7,0,0" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
                                        <Button Content="Start recording" Style="{StaticResource PrimaryButton}" Click="NewTake_Click" Padding="16,10" />
                                        <Button Content="Watch demo" Style="{StaticResource GhostButton}" Click="Demo_Click" Margin="9,0,0,0" Padding="16,10" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ═════════════ HEATMAP PAGE ═════════════ -->
                    <ScrollViewer x:Name="HeatmapPage" Style="{StaticResource PageScroll}" Visibility="Collapsed">
                        <StackPanel Margin="0,0,8,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="Heatmap" Style="{StaticResource H1}" FontSize="30" LineHeight="33" />
