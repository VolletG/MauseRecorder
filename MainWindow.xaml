                                                       FontSize="10.5" Margin="0,3,0,0" />

                                            <Border Style="{StaticResource Divider}" />

                                            <Grid Margin="0,0,0,11">
                                                <TextBlock Text="Start / stop recording" Style="{StaticResource SettingTitle}" FontSize="12.5" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="R" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid Margin="0,0,0,11">
                                                <TextBlock Text="Play / stop replay" Style="{StaticResource SettingTitle}" FontSize="12.5" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="P" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                </StackPanel>
                                            </Grid>
                                            <Grid>
                                                <TextBlock Text="Show / hide window" Style="{StaticResource SettingTitle}" FontSize="12.5" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}"><TextBlock Text="Alt" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                    <Border Style="{StaticResource KeyCap}" Margin="0"><TextBlock Text="H" FontSize="9.5" Foreground="#A5ACBC" /></Border>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="YOUR DATA" Style="{StaticResource Eyebrow}" />
                                            <TextBlock Text="100% local. Yours forever." Style="{StaticResource Caption}" FontSize="10.5" Margin="0,3,0,0" />

                                            <Border Style="{StaticResource Divider}" />

                                            <TextBlock x:Name="DataPathText" Style="{StaticResource Caption}" FontSize="10" TextWrapping="Wrap"
                                                       Foreground="#6D7586" />

                                            <StackPanel Orientation="Horizontal" Margin="0,13,0,0">
                                                <Button Content="Open folder" Style="{StaticResource GhostButton}" Click="OpenFolder_Click" Padding="12,8" FontSize="11.5" />
                                                <Button Content="Clear archive" Style="{StaticResource DangerQuietButton}" Click="ClearArchive_Click" Margin="8,0,0,0" FontSize="11.5" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,0">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentBrush}">
                                                    <Path Data="M5,2 L5,20 L9.6,15.4 L13,23 L16,21.6 L12.7,14.4 L20,14.4 Z"
                                                          Fill="#08080B" Stretch="Uniform" Width="19" Height="20" />
                                                </Border>
                                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="MauseRecorder" Style="{StaticResource H3}" />
                                                    <TextBlock Text="v1.0.0 · Made of clicks" Style="{StaticResource Caption}" FontSize="9.5" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock Text="A tiny Windows studio for recording, replaying and gently roasting your mouse habits."
                                                       Style="{StaticResource Body}" FontSize="11.5" Margin="0,12,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button Content="★  Star on GitHub" Style="{StaticResource AccentQuietButton}" Click="StarGithub_Click" FontSize="11.5" />
                                                <Button Content="Reset settings" Style="{StaticResource QuietButton}" Click="ResetSettings_Click" FontSize="11" Margin="6,0,0,0" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Toast -->
                    <Border x:Name="Toast" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#11141B" BorderBrush="#2C3341" BorderThickness="1" CornerRadius="13"
                            Padding="15,12" Margin="0,0,4,2" MaxWidth="380" Panel.ZIndex="80">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="26" ShadowDepth="6" Opacity="0.55" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ToastIcon" Width="30" Height="30" CornerRadius="9"
                                    Background="{DynamicResource AccentFaintBrush}" VerticalAlignment="Top">
                                <TextBlock x:Name="ToastGlyph" Text="✓" FontSize="13" Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,4,0" MaxWidth="300">
                                <TextBlock x:Name="ToastTitle" Text="Take saved" Style="{StaticResource H3}" FontSize="12.5" />
                                <TextBlock x:Name="ToastText" Text="" Style="{StaticResource Caption}" FontSize="11"
                                           TextWrapping="Wrap" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Canvas x:Name="ConfettiCanvas" IsHitTestVisible="False" ClipToBounds="True" Panel.ZIndex="90" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
