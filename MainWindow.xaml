                                    <TextBlock x:Name="ArchiveTotalTime" Text="{DynamicResource S_00_00_recorded}" Style="{StaticResource Caption}" FontSize="11" />
                                </Border>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,14,0,0">
