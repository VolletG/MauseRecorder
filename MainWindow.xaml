                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="↓" FontSize="12" Margin="0,0,7,0" />
                                            <TextBlock Text="Export card" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border x:Name="ShareRoot" Background="{DynamicResource BgBrush}" Margin="0,18,0,0" Padding="0">
