                                                </StackPanel>
                                                <Border Background="#11141B" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                        CornerRadius="99" Padding="10,5" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                    <TextBlock x:Name="HeatTakeCount" Text="0 takes" Style="{StaticResource Caption}" FontSize="10" />
