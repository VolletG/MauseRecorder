                    <!-- ═════════════ ARCHIVE PAGE ═════════════ -->
                    <Grid x:Name="ArchivePage" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <StackPanel>
                                <TextBlock Text="The archive" Style="{StaticResource H1}" FontSize="30" LineHeight="33" />
                                <TextBlock Text="Every take, saved locally. Replay, rename or delete." Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Grid Width="238" Margin="0,0,9,0">
                                    <TextBox x:Name="ArchiveSearch" Style="{StaticResource DarkTextBox}" Padding="34,9,10,9"
                                             TextChanged="ArchiveSearch_TextChanged" />
                                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{DynamicResource FaintBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False" />
                                    <TextBlock x:Name="SearchPlaceholder" Text="Search takes…" FontSize="11.5" Foreground="#555D6E"
                                               VerticalAlignment="Center" Margin="34,0,0,0" IsHitTestVisible="False" />
                                </Grid>
                                <Button Style="{StaticResource PrimaryButton}" Click="NewTake_Click" Padding="15,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="+" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="New take" FontSize="12" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,17,0,0">
