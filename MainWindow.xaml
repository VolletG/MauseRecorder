                                                    BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="▶" FontSize="11" Foreground="{DynamicResource AccentBrush}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                                            </Border>

                                            <StackPanel Grid.Column="1" Margin="13,0,10,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource H3}" FontSize="13.5"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <TextBlock Text="{Binding CreatedLabel}" Style="{StaticResource Caption}" FontSize="10.5" />
                                                    <TextBlock Text="  ·  " Style="{StaticResource Caption}" FontSize="10.5" Foreground="#414858" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Caption}" FontSize="10.5" />
