                                    </Grid.ColumnDefinitions>

                                    <Border Style="{StaticResource Card}" Padding="22,18">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock Text="ALL-TIME HEATMAP" Style="{StaticResource Eyebrow}" />
