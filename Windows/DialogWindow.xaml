<Window x:Class="MauseRecorder.Windows.DialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="450"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Margin="18" Background="#0C0E13" BorderBrush="#2A303D" BorderThickness="1"
            CornerRadius="18" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="{DynamicResource AccentFaintBrush}"
                            BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                        <Path Data="M5,2 L5,21 L10,16 L14,24 L17,22.5 L13,15 L20,15 Z"
                              Fill="{DynamicResource AccentBrush}" Stretch="Uniform" Width="15" Height="15"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="EyebrowText" Text="{DynamicResource S_MauseRecorder}" Style="{StaticResource Eyebrow}" />
                        <TextBlock x:Name="TitleText" Text="{DynamicResource S_Dialog}" Style="{StaticResource H2}" FontSize="19" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
                <Button Content="&#xE8BB;" Style="{StaticResource IconButton}" FontFamily="Segoe MDL2 Assets"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Click="Cancel_Click" />
            </Grid>

            <TextBlock x:Name="MessageText" Grid.Row="1" Style="{StaticResource Body}" Margin="0,18,0,0" />

            <StackPanel Grid.Row="2">
                <TextBlock x:Name="InputLabel" Text="{DynamicResource S_TAKE_NAME}" Style="{StaticResource Micro}" Margin="0,18,0,7" />
                <TextBox x:Name="InputBox" Style="{StaticResource DarkTextBox}" MaxLength="64" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                <Button x:Name="CancelButton" Content="{DynamicResource S_Cancel}" Style="{StaticResource QuietButton}"
                        Click="Cancel_Click" Margin="0,0,8,0" />
                <Button x:Name="ConfirmButton" Content="{DynamicResource S_Confirm}" Style="{StaticResource PrimaryButton}"
                        Click="Confirm_Click" MinWidth="104" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
