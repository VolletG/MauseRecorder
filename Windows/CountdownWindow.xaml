<Window x:Class="MauseRecorder.Windows.CountdownWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="320" Height="330"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Display, Segoe UI">
    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Grid Width="176" Height="176">
                <Ellipse Fill="#0B0D12" Stroke="{DynamicResource AccentGlowBrush}" StrokeThickness="1.5" />
                <Ellipse Margin="10" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                         StrokeDashArray="1 6" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <RotateTransform />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:12" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="NumberText" Text="3" FontSize="76" FontWeight="Bold"
                               Foreground="#F4F5F8" HorizontalAlignment="Center" LineHeight="76"
                               RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <ScaleTransform ScaleX="1" ScaleY="1" />
                        </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock Text="GET READY" Style="{StaticResource Eyebrow}" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <Border Background="#0C0E13" BorderBrush="#272C37" BorderThickness="1" CornerRadius="99"
                    Padding="16,8" HorizontalAlignment="Center" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="#FF4D5E" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Recording starts in a moment" Style="{StaticResource Caption}"
                               Foreground="#C9CEDA" FontSize="11.5" />
                </StackPanel>
            </Border>
            <TextBlock Text="Ctrl + Alt + R to cancel" Style="{StaticResource Caption}" FontSize="10.5"
                       HorizontalAlignment="Center" Margin="0,12,0,0" Foreground="#5A6172" />
        </StackPanel>
    </Grid>
</Window>
